dat <- read.csv('~/Downloads/data_apim_2.csv', na.strings = c('', ' ', '-999'))
summary(dat)
dat$CTSmom_MomAllABofAdo <- scale(dat$CTSmom_MomAllABofAdo)
dat$CTSmom_AdoAllABofMom <- scale(dat$CTSmom_AdoAllABofMom)
dat$CTSado_MomAllPhysABofAdo <- scale(dat$CTSado_MomAllPhysABofAdo)
## MODEL 1 - 2 predictors, 2 mediators, 2 outcomes
m1Dat <- dat[,c('aattacare', 'scidabordthresh1aban', 'scidabordthresh5suicselfmut',
'aattprole', 'scidpbordRe', 'CTSmom_MomAllABofAdo', 'scidabordthresh8intenseang')]
m1Dat <- m1Dat[!is.na(m1Dat$scidpbordRe),]
m1Dat <- m1Dat[!is.na(m1Dat$scidabordthresh5suicselfmut),]
m1Dat <- m1Dat[!is.na(m1Dat$CTSmom_MomAllABofAdo),]
summary(m1Dat)
m1 <- 'aattacare ~ scidabordthresh1aban # Adolescent RC (M1) predicted by avoidance of abandonment (X1)
scidabordthresh5suicselfmut ~ scidabordthresh1aban  # adolescent self-harm (Y1) predicted by avoidance of abandonment (X1)
scidabordthresh5suicselfmut ~ aattacare # adolescent self-harm (Y1) predicted by Adolescent RC (M1)
aattprole ~ scidpbordRe # Parent RC (M2) predicted by Parent BPD (X2)
CTSmom_MomAllABofAdo ~ scidpbordRe  # abuse torwards adolescent (Y2) predicted by Parent BPD (X2)
CTSmom_MomAllABofAdo ~ aattprole # abuse torwards adolescent (Y2) predicted by Parent RC (M2)
aattacare ~ scidpbordRe # Adolescent RC (M1) predicted by Parent BPD (X2)
CTSmom_MomAllABofAdo ~ aattacare # abuse torwards adolescent (Y2) predicted by Adolescent RC (M1)
aattprole ~ scidabordthresh1aban # Parent RC (M2) predicted by avoidance of abandonment (X1)
scidabordthresh5suicselfmut ~ aattprole # adolescent self-harm (Y1) predicted by Parent RC (M2)
CTSmom_MomAllABofAdo ~ scidabordthresh1aban # abuse torwards adolescent (Y2) predicted by avoidance of abandonment (X1)
scidabordthresh5suicselfmut ~ scidpbordRe # adolescent self-harm (Y1) predicted by Parent BPD (X2)
'
m1Est <- sem(m1, data = m1Dat, ordered = c('aattacare',
'scidabordthresh5suicselfmut',
'aattprole'))
summary(m1Est)
